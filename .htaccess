# ----------------------------------------------------------------------
# Redirections : forcer HTTPS + version non-www (domaine canonique)
# ----------------------------------------------------------------------
RewriteEngine On

# www -> non-www
RewriteCond %{HTTP_HOST} ^www\.villaanduze\.fr [NC]
RewriteRule ^(.*)$ https://villaanduze.fr/$1 [L,R=301]

# HTTP -> HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://villaanduze.fr/$1 [L,R=301]

# ----------------------------------------------------------------------
# Cache navigateur (assets versionnés)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType video/webm "access plus 6 months"
  ExpiresByType video/mp4 "access plus 6 months"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ----------------------------------------------------------------------
# Compression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

# ----------------------------------------------------------------------
# En-têtes de sécurité
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
